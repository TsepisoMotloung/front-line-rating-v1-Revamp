# Copy this file to .env.docker and keep the copy out of git.
# Add the hCaptcha values supplied for your deployment.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Generate a private value for any shared or production deployment.
NEXTAUTH_SECRET=local-development-secret-change-me
APP_NAME=Service Feedback Platform
