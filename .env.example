# Database
DATABASE_URL="mysql://username:password@host:port/database"

# NextAuth (REQUIRED - See VERCEL_SETUP.md for production configuration)
# For local development: http://localhost:3000
# For Vercel production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-at-least-32-chars-long"

# Email Configuration (for NodeMailer)
EMAIL_SERVER_HOST="host-address"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="your_password"
EMAIL_FROM="example@example.com"

# hCaptcha Configuration
# Get your keys from: https://www.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET_KEY="0x0000000000000000000000000000000000000000"

# Application
APP_NAME="Service Feedback Platform"
APP_URL="http://localhost:3000"
